# ==============================================================================
# QA PILOT - CẤU HÌNH NHÀ CUNG CẤP MÔ HÌNH AI (MULTI-MODEL PROVIDER)
# Sao chép tệp này thành .env.local và điền API Key của mô hình bạn muốn dùng.
# Nếu không điền gì, QA Pilot sẽ chạy ở chế độ "Playwright Native Heuristics (Zero-Token)".
# ==============================================================================

# 1. DEEPSEEK (V3 / R1 - Chi phí siêu rẻ, suy luận sắc bén)
# QA_MODEL_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# QA_MODEL_NAME=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 2. QWEN (Alibaba DashScope - Thị giác máy tính UI cực đỉnh với Qwen-2.5-VL)
# QA_MODEL_PROVIDER=qwen
# QWEN_API_KEY=sk-your-dashscope-key
# QA_MODEL_NAME=qwen-2.5-vl
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 3. CLAUDE (Anthropic - Đỉnh cao về logic kiểm thử và suy luận chất lượng)
# QA_MODEL_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-your-claude-key
# QA_MODEL_NAME=claude-3-5-sonnet
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# 4. OLLAMA (Chạy 100% Cục bộ offline, Không tốn token, Bảo mật tối đa)
# QA_MODEL_PROVIDER=ollama
# QA_MODEL_NAME=qwen2.5:latest
# OLLAMA_BASE_URL=http://localhost:11434/v1

# 5. OPENAI / GEMINI
# OPENAI_API_KEY=sk-your-openai-key
# QA_MODEL_NAME=gpt-4o-mini
# GEMINI_API_KEY=your-gemini-key

