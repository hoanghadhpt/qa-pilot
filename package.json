{
  "name": "qa-pilot-monorepo",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "description": "Agentic AI Web Testing Platform for Antigravity powered by MCP, Midscene.js and Playwright",
  "scripts": {
    "build": "npm --prefix packages/qa-pilot run build",
    "dev": "npm --prefix packages/qa-pilot run dev",
    "test": "npm --prefix packages/qa-pilot test",
    "publish:npm": "cd packages/qa-pilot && npm publish --access public"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "concurrently": "^8.2.2",
    "dotenv": "^18.0.9"
  }
}
