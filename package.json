{
  "name": "qa-pilot-monorepo",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "description": "Agentic AI Web Testing Platform for Antigravity powered by MCP, Midscene.js and Playwright",
  "scripts": {
    "build:mcp": "npm --prefix packages/mcp-server run build",
    "build:cli": "npm --prefix packages/cli run build",
    "dev:mcp": "npm --prefix packages/mcp-server run dev",
    "build": "npm run build:mcp && npm run build:cli",
    "test:cli": "node packages/cli/dist/verify-cli.js && node packages/cli/dist/verify-search.js",
    "publish:mcp": "npm --prefix packages/mcp-server publish --access public",
    "publish:cli": "npm --prefix packages/cli publish --access public",
    "publish:all": "npm run publish:mcp && npm run publish:cli",
    "dev": "npm run dev:mcp"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "concurrently": "^8.2.2",
    "dotenv": "^18.0.9"
  }
}
