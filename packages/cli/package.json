{
  "name": "qa-pilot",
  "version": "0.1.0",
  "description": "CLI and Distribution toolkit for QA Pilot Agentic Testing Platform",
  "type": "module",
  "bin": {
    "qa-pilot": "bin/qa-pilot.js"
  },
  "main": "dist/index.js",
  "files": [
    "bin",
    "dist",
    "assets"
  ],
  "scripts": {
    "copy-assets": "node -e \"import fs from 'node:fs'; fs.cpSync('../../.agents/skills/qa-pilot', './assets/skills/qa-pilot', { recursive: true });\"",
    "build": "npm run copy-assets && tsc",
    "dev": "tsc -w",
    "test": "node dist/verify-cli.js && node dist/verify-search.js"
  },
  "keywords": [
    "qa",
    "playwright",
    "mcp",
    "antigravity",
    "testing",
    "ai-agent"
  ],
  "author": "QA Pilot Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  }
}

